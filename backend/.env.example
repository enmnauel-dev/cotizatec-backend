# Backend CotizaTec — variables de entorno

# Clave secreta para firmar licencias (Ed25519). Genera con: npm run genkeys
# LICENCE_PRIVATE_KEY y LICENSE_PUBLIC_KEY se generan y se copian aqui.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Token del bot de Telegram (de @BotFather)
TELEGRAM_TOKEN=

# Chat ID del administrador (tu chat con el bot). Se muestra al hacer /start
ADMIN_CHAT_ID=

# Duracion de la licencia por defecto al activar (en dias), ej. 30
LICENSE_DAYS=30

# Dias de gracia despues del vencimiento antes de bloquear
GRACE_DAYS=15

# Dias de prueba automatica para un dispositivo nuevo (sin licencia)
TRIAL_DAYS=15

# Telefono de WhatsApp del soporte (se envia a los dispositivos bloqueados
# para el boton "Contactar por WhatsApp"). Formato internacional: 1XXXXXXXXXX
SUPPORT_PHONE=

# Puerto del servidor HTTP
PORT=3000